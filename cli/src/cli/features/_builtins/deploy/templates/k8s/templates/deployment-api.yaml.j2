apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ "{{ .Release.Name }}" }}-api
spec:
  replicas: {{ "{{ .Values.api.replicas }}" }}
  selector:
    matchLabels:
      app: {{ "{{ .Release.Name }}" }}-api
  template:
    metadata:
      labels:
        app: {{ "{{ .Release.Name }}" }}-api
    spec:
      containers:
        - name: api
          image: {{ "{{ .Values.api.image }}" }}
          ports:
            - containerPort: {{ "{{ .Values.api.port }}" }}
          env:
            - name: CODE_VERSION
              value: {{ "{{ .Values.api.codeVersion }}" }}
          envFrom:
            - secretRef:
                name: {{ "{{ .Release.Name }}" }}-env
