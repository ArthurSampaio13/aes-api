apiVersion: v2
name: {{ project_name }}
description: Helm chart for {{ project_name }} — API, worker, Postgres, LocalStack.
version: 0.1.0
appVersion: "0.1.0"
dependencies:
  - name: postgresql
    version: "16.x.x"
    repository: "oci://registry-1.docker.io/bitnamicharts"
    condition: postgresql.enabled
  - name: localstack
    version: "0.6.x"
    repository: "https://localstack.github.io/helm-charts"
    condition: localstack.enabled
