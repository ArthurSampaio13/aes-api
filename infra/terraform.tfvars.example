node_image = "kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a"

# Optional LLM gateway credentials. Leave a key empty to leave that provider
# unconfigured — GET /api/v1/aes/models reports it as available: false.
# Free tiers verified 2026-09-05; re-check before relying on one.
openrouter_api_key = ""
groq_api_key       = ""
cerebras_api_key   = ""
github_api_key     = ""
gemini_api_key     = ""

# O S3 e a fila do LocalStack leem a regiao daqui; nao ha chamada a AWS real.
aws_region = "us-east-1"

# mock mantem tudo offline; vision manda a imagem a um modelo multimodal via
# OpenRouter.
ocr_provider = "vision"
vision_model = "deepseek/deepseek-v4.1-flash"
