node_image = "kindest/node:v1.34.0@sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a"

# Optional LLM gateway credentials. Leave a key empty to leave that provider
# unconfigured — GET /api/v1/aes/models reports it as available: false.
# Free tiers verified 2026-09-05; re-check before relying on one.
openrouter_api_key = ""
groq_api_key       = ""
cerebras_api_key   = ""
github_api_key     = ""
gemini_api_key     = ""

# Textract roda na AWS de verdade: nao ha emulacao no LocalStack. O perfil local
# abaixo provisiona o bucket do emissor OIDC e a role; os pods nao usam chave
# nenhuma, eles trocam o token do service account por credenciais temporarias.
# Textract nao existe em sa-east-1 — mantenha uma regiao que o ofereca.
aws_profile = "tcc"
aws_region  = "us-east-1"

# textract chama a AWS; mock mantem tudo offline.
ocr_provider = "textract"
